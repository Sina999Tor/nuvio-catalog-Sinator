{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/catalog.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest" },
    { "source": "/:key/manifest.json", "destination": "/api/manifest" },
    { "source": "/:key/catalog/:type/:id.json", "destination": "/api/catalog" },
    { "source": "/:key/meta/:type/:id.json", "destination": "/api/meta" }
  ]
}
